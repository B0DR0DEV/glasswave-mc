{
  "schemaVersion": 1,
  "id": "glasswave",
  "version": "${version}",
  "name": "Glasswave",
  "description": "A soft, floating glass music player for Minecraft.",
  "authors": ["B0DR0DEV"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.glasswave.GlasswaveClient"]
  },
